# Copy this file to .env.local for local development and add your key there.
GEMINI_API_KEY=

# Send Query email delivery through EmailJS (keep these server-side).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional EmailJS private key; recommended when enabled in EmailJS account security.
EMAILJS_PRIVATE_KEY=
# Set true only when the EmailJS plan and template are configured for file attachments.
EMAILJS_ATTACHMENTS_ENABLED=false

# Random secret of at least 32 characters for signed, expiring email verification cookies.
SEND_QUERY_VERIFICATION_SECRET=
